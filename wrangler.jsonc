{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automerge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1,
    },
  },
  "secrets": {
    "required": ["GITHUB_APP_PRIVATE_KEY", "GITHUB_WEBHOOK_SECRET"],
  },
}
